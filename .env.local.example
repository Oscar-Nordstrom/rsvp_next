# Supabase project settings (Project Settings > API)
# These are server-only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the /admin guest list. Pick something long and unique to
# this site — it's the only thing protecting the admin panel.
ADMIN_PASSWORD=change-me
